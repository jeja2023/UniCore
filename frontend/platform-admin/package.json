{
  "name": "platform-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:design-system": "powershell -ExecutionPolicy Bypass -File ./scripts/check-design-system-compliance.ps1",
    "format": "prettier -w .",
    "sdk:generate": "powershell -ExecutionPolicy Bypass -File ./scripts/generate-sdk.ps1 -UseLocalPackage",
    "sdk:export-and-generate": "powershell -ExecutionPolicy Bypass -File ./scripts/export-openapi-and-generate-sdk.ps1",
    "sdk:check": "powershell -ExecutionPolicy Bypass -File ./scripts/check-sdk-up-to-date.ps1"
  },
  "dependencies": {
    "@unicore/sample-module": "file:../modules/sample-module",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@eslint/js": "^9.9.1",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.4.0",
    "vite": "^5.4.3",
    "openapi-typescript": "^7.10.1"
  }
}
