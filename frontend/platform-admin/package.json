{
  "name": "platform-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "registry:generate": "node ./scripts/run-ps.mjs -ExecutionPolicy Bypass -File ./scripts/generate-module-registry.ps1",
    "modules:validate": "node ./scripts/run-ps.mjs -ExecutionPolicy Bypass -File ./scripts/validate-frontend-modules.ps1",
    "modules:check-contracts": "node ./scripts/run-ps.mjs -ExecutionPolicy Bypass -File ./scripts/check-module-contract-alignment.ps1",
    "modules:check-contracts:ci": "node ./scripts/run-ps.mjs -ExecutionPolicy Bypass -File ./scripts/check-module-contract-alignment.ps1 -OutputJson -JsonOutputPath ./artifacts/module-contract-alignment-report.json",
    "modules:sync": "npm run registry:generate && npm run modules:validate",
    "ci:checks": "npm run check:powershell-syntax && npm run modules:sync && npm run check:design-system && npm run check:no-emoji",
    "ci:checks:strict": "npm run ci:checks && npm run lint",
    "predev": "npm run modules:sync",
    "dev": "vite",
    "dev:fast": "vite",
    "prebuild": "npm run modules:sync",
    "build": "tsc -p tsconfig.json && vite build",
    "build:verified": "npm run check:powershell-syntax && npm run modules:sync && npm run modules:check-contracts && npm run test:coverage && tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "prelint": "npm run modules:sync",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:design-system": "node ./scripts/run-ps.mjs -ExecutionPolicy Bypass -File ./scripts/check-design-system-compliance.ps1",
    "check:powershell-syntax": "node ./scripts/run-ps.mjs -ExecutionPolicy Bypass -File ./scripts/check-powershell-syntax.ps1",
    "check:no-emoji": "node ./scripts/check-no-emoji.mjs",
    "format": "prettier -w .",
    "sdk:generate": "node ./scripts/run-ps.mjs -ExecutionPolicy Bypass -File ./scripts/generate-sdk.ps1",
    "sdk:export-and-generate": "node ./scripts/run-ps.mjs -ExecutionPolicy Bypass -File ./scripts/export-openapi-and-generate-sdk.ps1",
    "sdk:check": "node ./scripts/run-ps.mjs -ExecutionPolicy Bypass -File ./scripts/check-sdk-up-to-date.ps1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^19.2.5",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "jsdom": "^29.0.2",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.4.0",
    "vite": "^5.4.3",
    "vitest": "^4.1.4"
  }
}
