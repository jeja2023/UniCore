{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=unicore;Username=postgres;Password=<your-password>"
  },
  "Seed": {
    "AdminPassword": "UniCore@123"
  },
  "Swagger": {
    "EnableInNonDevelopment": true
  },
  "Jwt": {
    "Issuer": "UniCore",
    "Audience": "UniCore.Admin",
    "SigningKey": "<at-least-32-characters-signing-key>",
    "AccessTokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "Telemetry": {
    "ServiceName": "UniCore.WebApi",
    "ServiceVersion": "dev",
    "EnableOtlpExporter": false,
    "Otlp": {
      "Endpoint": "http://localhost:4317"
    }
  },
  "ObjectStorage": {
    "Enabled": false,
    "Endpoint": "http://localhost:9000",
    "AccessKey": "<access-key>",
    "SecretKey": "<secret-key>",
    "BucketName": "unicore-files",
    "UseSsl": false,
    "ForcePathStyle": true
  }
}
