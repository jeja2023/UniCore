{
  "UseInMemoryDatabase": false,
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "Default": "Host=<prod-db-host>;Port=5432;Database=unicore_prod;Username=<db-user>;Password=<db-password>"
  },
  "Seed": {
    "AdminPassword": "<managed-in-secret-store>"
  },
  "Swagger": {
    "EnableInNonDevelopment": false
  },
  "Jwt": {
    "Issuer": "UniCore",
    "Audience": "UniCore.Admin",
    "SigningKey": "<managed-in-secret-store-32+>",
    "AccessTokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7,
    "UserEnabledCacheSeconds": 15
  },
  "Telemetry": {
    "ServiceName": "UniCore.WebApi",
    "ServiceVersion": "<release-version>",
    "EnableOtlpExporter": true,
    "Otlp": {
      "Endpoint": "http://otel-collector.observability.svc.cluster.local:4317"
    }
  },
  "FeatureFlags": {
    "AuditExportCallbackEnabled": "true",
    "MetricsEnabled": "true"
  },
  "RequestAudit": {
    "AuditHttpGet": true,
    "SamplingPercent": 100
  },
  "RedisCache": {
    "Enabled": true,
    "ConnectionString": "<prod-redis-connection>"
  },
  "ObjectStorage": {
    "Enabled": true,
    "Endpoint": "https://<prod-object-storage>",
    "AccessKey": "<managed-in-secret-store>",
    "SecretKey": "<managed-in-secret-store>",
    "BucketName": "unicore-prod-files",
    "UseSsl": true,
    "ForcePathStyle": false
  },
  "NotificationChannels": {
    "Email": {
      "Enabled": true,
      "Host": "<smtp-host>",
      "Port": 587,
      "EnableSsl": true,
      "Username": "<managed-in-secret-store>",
      "Password": "<managed-in-secret-store>",
      "FromAddress": "noreply@unicore.example.com"
    },
    "Sms": {
      "Enabled": true,
      "ProviderUrl": "https://<sms-provider>/api/messages",
      "ApiKey": "<managed-in-secret-store>",
      "SenderId": "UniCore"
    }
  }
}
