{
  "UseInMemoryDatabase": true,
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Seed": {
    "AdminPassword": "<set-by-test-secret>"
  },
  "Swagger": {
    "EnableInNonDevelopment": true
  },
  "Jwt": {
    "Issuer": "UniCore",
    "Audience": "UniCore.Admin",
    "SigningKey": "<at-least-32-characters-test-key>",
    "AccessTokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7,
    "UserEnabledCacheSeconds": 0
  },
  "FeatureFlags": {
    "AuditExportCallbackEnabled": "false",
    "MetricsEnabled": "true"
  },
  "RequestAudit": {
    "AuditHttpGet": true,
    "SamplingPercent": 100
  },
  "RedisCache": {
    "Enabled": false,
    "ConnectionString": "localhost:6379"
  }
}
