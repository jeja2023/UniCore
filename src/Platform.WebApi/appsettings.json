{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=unicore;Username=postgres;Password=123456"
  },
  "Jwt": {
    "Issuer": "UniCore",
    "Audience": "UniCore.Admin",
    "SigningKey": "UniCore_Default_Very_Strong_Signing_Key_2026",
    "AccessTokenExpireMinutes": 60,
    "RefreshTokenExpireDays": 7
  },
  "LoginSecurity": {
    "MaxFailAttempts": 5,
    "FailWindowMinutes": 10,
    "LockMinutes": 10
  },
  "AuditExportCleanup": {
    "Enabled": true,
    "Ttl": "24:00:00",
    "RunInterval": "00:30:00"
  },
  "AuditExportCallback": {
    "SigningKey": ""
  },
  "FeatureFlags": {
    "AuditExportCallbackEnabled": "true",
    "MetricsEnabled": "true"
  },
  "RedisCache": {
    "Enabled": false,
    "ConnectionString": "localhost:6379"
  },
  "ObjectStorage": {
    "Enabled": false,
    "Endpoint": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "unicore-files",
    "UseSsl": false,
    "ForcePathStyle": true
  },
  "JobScheduling": {
    "Enabled": true,
    "PollInterval": "00:00:20"
  },
  "NotificationChannels": {
    "Email": {
      "Enabled": false,
      "Host": "smtp.example.com",
      "Port": 587,
      "EnableSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "noreply@unicore.local"
    },
    "Sms": {
      "Enabled": false,
      "ProviderUrl": "https://sms-provider.example.com/api/messages",
      "ApiKey": "",
      "SenderId": "UniCore"
    }
  },
  "LocalFileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning",
      "Microsoft.EntityFrameworkCore.Query": "Warning"
    }
  }
}
